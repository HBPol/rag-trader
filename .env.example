# Environment defaults for local development
ENV=dev
RAGTRADER_API_ENV=${ENV}

# Ports
API_PORT=8000
WEB_PORT=5173

# Postgres (dev via docker service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragtrader
POSTGRES_USER=ragtrader
POSTGRES_PASSWORD=ragtrader
RAGTRADER_API_POSTGRES_DSN=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
RAGTRADER_API_REQUIRE_DATABASE=true

# Vector store (default to Qdrant Cloud; override with docker-compose.override.yml for local)
QDRANT_URL=https://<your-qdrant-endpoint>
QDRANT_API_KEY=<your-qdrant-api-key>
RAGTRADER_API_QDRANT_URL=${QDRANT_URL}
RAGTRADER_API_QDRANT_API_KEY=${QDRANT_API_KEY}  # Cloud default: required while RAGTRADER_API_USE_QDRANT_CLOUD=true
RAGTRADER_API_USE_QDRANT_CLOUD=true  # Self-hosted override: set to false and omit the API key to disable auth
RAGTRADER_API_REQUIRE_VECTOR_STORE=true
RAGTRADER_API_CORS_ORIGINS=http://localhost:5173  # set to deployed frontend URL in prod/staging

# External APIs
COINBASE_API_BASE=https://api.exchange.coinbase.com

# Reachability probes (CI + manual)
REACHABILITY_SKIP_ALL=false
REACHABILITY_SKIP_COINBASE=false
REACHABILITY_SKIP_RSS=false
REACHABILITY_SKIP_QDRANT=false
REACHABILITY_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://www.reddit.com/r/CryptoCurrency/.rss
REACHABILITY_TIMEOUT_SECONDS=10
REACHABILITY_QDRANT_URL=${QDRANT_URL}

# Optional API keys
# COINBASE_API_KEY=
# RSS_BASIC_AUTH= # format: username:password for feeds that require HTTP Basic auth
# For self-hosted Qdrant: set RAGTRADER_API_USE_QDRANT_CLOUD=false and leave the API key blank
# RAGTRADER_API_QDRANT_API_KEY=
# QDRANT_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MOCK_STATE=authenticated

